Algoritmo "EXERCICIO ESTRUTURA DE DECISÃO 8"
Var
qntd_clinicos,qntd_pediatras,qntd_cirurgioes:inteiro
somamedicos:inteiro
Inicio
escreval ("Insira a quantidade de Clínicos Gerais para o turno: ")
leia (qntd_clinicos)

limpatela

escreval ("Insira a quantidade de Pediatras para o turno: ")
leia (qntd_pediatras)

limpatela

escreval ("Insira a quantidade de Cirurgiões para o turno: ")
leia (qntd_cirurgioes)

somamedicos <- (qntd_clinicos) + (qntd_pediatras) + (qntd_cirurgioes)

leia (somamedicos)

escreva ("A quantidade total de médicos do turno é: ", somamedicos)

Fimalgoritmo